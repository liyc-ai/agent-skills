# ============================================================
# tmux 3.5+ / macOS 交互配置示例
# 重新加载：tmux source-file ~/.tmux.conf
# ============================================================

# ---------- 基础 ----------
set -g default-terminal "tmux-256color"
set -ag terminal-overrides ",xterm-256color:RGB"
set -g base-index 1
setw -g pane-base-index 1
set -g renumber-windows on
set -g history-limit 100000
set -g focus-events on

set -g mode-keys vi
set -g status-keys vi

# ---------- 新窗口提示命名 ----------
# prefix + c：在当前目录新建窗口，底部提示「窗口名称:」
# 默认填入当前目录名；直接 Enter 使用默认值，C-u 清空后输入新名称
bind c new-window -c "#{pane_current_path}" \; \
	command-prompt -p "窗口名称:" -I "#{b:pane_current_path}" \
	"rename-window -- '%%'"

# ---------- 鼠标 / 触摸板 ----------
set -g mouse on

# ---------- 复制到系统剪贴板 ----------
set -g set-clipboard on

# vi copy-mode
bind -T copy-mode-vi Enter send-keys -X copy-pipe-and-cancel "pbcopy"
bind -T copy-mode-vi y send-keys -X copy-pipe-and-cancel "pbcopy"
bind -T copy-mode-vi MouseDragEnd1Pane \
	send-keys -X copy-pipe-and-cancel "pbcopy"
bind -T copy-mode-vi DoubleClick1Pane select-pane \; \
	send-keys -X select-word \; run-shell -d 0.3 \; \
	send-keys -X copy-pipe-and-cancel "pbcopy"
bind -T copy-mode-vi TripleClick1Pane select-pane \; \
	send-keys -X select-line \; run-shell -d 0.3 \; \
	send-keys -X copy-pipe-and-cancel "pbcopy"

# emacs copy-mode 兜底（正常使用 vi 时不会触发）
bind -T copy-mode Enter send-keys -X copy-pipe-and-cancel "pbcopy"
bind -T copy-mode MouseDragEnd1Pane \
	send-keys -X copy-pipe-and-cancel "pbcopy"
bind -T copy-mode DoubleClick1Pane select-pane \; \
	send-keys -X select-word \; run-shell -d 0.3 \; \
	send-keys -X copy-pipe-and-cancel "pbcopy"
bind -T copy-mode TripleClick1Pane select-pane \; \
	send-keys -X select-line \; run-shell -d 0.3 \; \
	send-keys -X copy-pipe-and-cancel "pbcopy"
